    "_route": {
      "host": "de-tender-query.p.rapidapi.com",
      "hub": "https://rapidapi.com/mrvn-mrvn-default/api/de-tender-query",
      "path": "/v1/notices/{id}"
    }
  },
  {
    "name": "tender_get_stats",
