[
  {
    "name": "tender_search_notices",
    "description": "Search/filter German public procurement notices by keyword, CPV, Bundesland, type, buyer, value, published date, or submission deadline. [German public procurement (oeffentlichevergabe.de, CC0)]",
    "inputSchema": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Keywords (all must match)"
        },
        "cpv": {
          "type": "string",
          "description": "Comma-separated CPV codes or prefixes"
        },
        "land": {
          "type": "string",
          "description": "Comma-separated Bundesland codes (BW,BY,…)"
        },
        "type": {
          "type": "string",
          "enum": [
            "tender",
            "award",
            "planning"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "works",
            "services",
            "goods"
          ]
        },
        "buyer": {
          "type": "string"
        },
        "postal_prefix": {
          "type": "string"
        },
        "min_value": {
          "type": "number"
        },
        "max_value": {
          "type": "number"
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "end_after": {
          "type": "string",
          "format": "date",
          "description": "Submission deadline on/after"
        },
        "end_before": {
          "type": "string",
          "format": "date",
          "description": "Submission deadline on/before"
        },
        "sort": {
          "type": "string",
          "enum": [
            "date",
            "value"
          ]
        },
        "fields": {
          "type": "string",
          "enum": [
            "full",
            "compact"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "_route": {
      "host": "de-tender-query.p.rapidapi.com",
      "hub": "https://rapidapi.com/mrvn-mrvn-default/api/de-tender-query",
      "path": "/v1/notices"
    }
  },
  {
    "name": "tender_get_notice",
    "description": "Get one notice by notice id or OCID. [German public procurement (oeffentlichevergabe.de, CC0)]",
    "inputSchema": {
